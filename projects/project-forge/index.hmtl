<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Eron Awakuni | Data Analytics Portfolio</title>
<meta name="description" content="Data analytics portfolio of Eron Awakuni: investigative analysis, technology support, reporting, and process improvement.">

<style>
:root {
    --navy: #14263d;
    --navy-deep: #0d1b2b;
    --blue: #315b80;
    --sky: #a9c9e8;
    --ice: #e5f1ff;
    --light: #f4f6f9;
    --white: #ffffff;
    --text: #263445;
    --muted: #5d6b7e;
    --line: #e1e6ed;
    --serif: Georgia, "Times New Roman", serif;
    --sans: "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: var(--sans);
    background: var(--light);
    color: var(--text);
    line-height: 1.7;
}

a:focus-visible,
button:focus-visible {
    outline: 3px solid var(--sky);
    outline-offset: 3px;
}

/* ---------- Header ---------- */
header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(20, 38, 61, 0.94);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: white;
    padding: 16px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    border-bottom: 1px solid rgba(169, 201, 232, 0.18);
}

header h2 {
    font-family: var(--serif);
    font-size: 21px;
    font-weight: normal;
    letter-spacing: 0.5px;
}

nav {
    display: flex;
    gap: 26px;
    flex-wrap: wrap;
}

nav a {
    color: #d6e0eb;
    text-decoration: none;
    font-size: 14px;
    padding: 4px 0;
    border-bottom: 2px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
}

nav a:hover {
    color: white;
    border-bottom-color: var(--sky);
}

/* ---------- Hero ---------- */
.hero {
    position: relative;
    overflow: hidden;
    padding: 120px 8% 130px;
    color: white;
    background:
        radial-gradient(ellipse at 75% 20%, rgba(169, 201, 232, 0.16) 0%, transparent 55%),
        radial-gradient(ellipse at 50% 42%, #345779 0%, #254461 38%, #1b334d 72%, #14263d 100%);
}

/* subtle grid texture */
.hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
        linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(ellipse at 30% 50%, black 10%, transparent 75%);
    mask-image: radial-gradient(ellipse at 30% 50%, black 10%, transparent 75%);
    pointer-events: none;
}

.hero-content {
    position: relative;
    max-width: 850px;
}

.hero .eyebrow {
    color: var(--sky);
    letter-spacing: 1.5px;
    font-size: 13px;
    font-weight: bold;
    padding-left: 14px;
    border-left: 3px solid var(--sky);
}

.hero h1 {
    font-family: var(--serif);
    font-weight: normal;
    font-size: clamp(38px, 6vw, 64px);
    line-height: 1.12;
    margin: 24px 0;
    color: var(--ice);
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.2);
}

.hero p {
    max-width: 640px;
    color: #d6e0eb;
    font-size: 18px;
}

.hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 34px;
}

.btn {
    display: inline-block;
    padding: 13px 26px;
    border-radius: 5px;
    text-decoration: none;
    font-weight: bold;
    font-size: 15px;
    font-family: inherit;
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

.btn-primary {
    background: white;
    color: var(--navy);
    border: 1px solid white;
}

.btn-primary:hover {
    background: var(--ice);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.22);
}

.btn-outline {
    background: transparent;
    color: var(--ice);
    border: 1px solid #7895b2;
}

.btn-outline:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--ice);
    transform: translateY(-2px);
}

/* ---------- Sections ---------- */
section {
    padding: 80px 8%;
    scroll-margin-top: 60px;
}

.section-heading {
    margin-bottom: 38px;
}

.section-heading h2 {
    font-family: var(--serif);
    font-weight: normal;
    font-size: 34px;
    color: var(--navy);
    line-height: 1.25;
}

.section-heading h2::after {
    content: "";
    display: block;
    width: 52px;
    height: 3px;
    background: var(--blue);
    margin-top: 14px;
    border-radius: 2px;
}

.section-heading p {
    color: var(--muted);
    margin-top: 12px;
}

/* ---------- About ---------- */
.about {
    background: white;
}

.about-content {
    max-width: 760px;
}

.about-content p {
    margin-bottom: 18px;
    font-size: 17px;
}

/* ---------- Projects ---------- */
.project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 26px;
}

.project-card {
    background: white;
    padding: 30px;
    border-radius: 8px;
    border: 1px solid var(--line);
    border-top: 4px solid var(--blue);
    box-shadow: 0 3px 12px rgba(20, 38, 61, 0.05);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.project-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 30px rgba(20, 38, 61, 0.12);
}

.project-card h3 {
    font-family: var(--serif);
    font-weight: normal;
    font-size: 22px;
    color: var(--navy);
    margin-bottom: 12px;
}

.project-card p {
    color: var(--muted);
    font-size: 15px;
    margin-bottom: 18px;
}

.project-tag {
    display: inline-block;
    background: #eaf0f6;
    color: var(--blue);
    padding: 4px 11px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    margin: 3px 3px 3px 0;
}

/* ---------- Skills ---------- */
.skills {
    background: white;
}

.skill-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 24px;
}

.skill-group {
    padding: 24px;
    border-left: 3px solid var(--blue);
    background: var(--light);
    border-radius: 0 6px 6px 0;
}

.skill-group h3 {
    color: var(--navy);
    margin-bottom: 10px;
    font-size: 17px;
}

.skill-group p {
    color: var(--muted);
    font-size: 14.5px;
}

/* ---------- Contact ---------- */
.contact {
    background:
        radial-gradient(ellipse at 50% 0%, #254461 0%, transparent 65%),
        var(--navy);
    color: white;
    text-align: center;
    padding: 90px 8%;
}

.contact h2 {
    font-family: var(--serif);
    font-weight: normal;
    font-size: 36px;
    margin-bottom: 16px;
}

.contact > p {
    color: #d6e0eb;
    max-width: 560px;
    margin: 0 auto;
}

.email-display {
    display: inline-block;
    margin-top: 30px;
    padding: 12px 22px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(169, 201, 232, 0.35);
    border-radius: 6px;
    color: var(--ice);
    font-size: 17px;
    letter-spacing: 0.3px;
    user-select: all;
    -webkit-user-select: all;
    word-break: break-all;
}

.contact-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 24px;
}

.copy-status {
    min-height: 24px;
    margin-top: 14px;
    font-size: 14px;
    color: var(--sky);
}

/* ---------- Footer ---------- */
footer {
    background: var(--navy-deep);
    color: #aab6c4;
    text-align: center;
    padding: 24px;
    font-size: 13px;
}

/* ---------- Responsive ---------- */
@media (max-width: 600px) {
    header {
        padding: 14px 6%;
        justify-content: center;
    }

    nav {
        gap: 18px;
        justify-content: center;
    }

    .hero {
        padding: 80px 6% 90px;
    }

    section {
        padding: 60px 6%;
    }

    .hero p {
        font-size: 17px;
    }
}

@media (prefers-reduced-motion: reduce) {
    html {
        scroll-behavior: auto;
    }

    * {
        transition: none !important;
    }
}
</style>
</head>

<body>

<header>
    <h2>Eron Awakuni</h2>
    <nav>
        <a href="#about">About</a>
        <a href="#projects">Projects</a>
        <a href="#skills">Skills</a>
        <a href="#contact">Contact</a>
    </nav>
</header>

<main>

<section class="hero">
    <div class="hero-content">
        <div class="eyebrow">Data Analytics | Problem Solving | Technology</div>

        <h1>Turning Information Into Actionable Insights.</h1>

        <p>
            A professional background in investigative analysis,
            technology support, and problem-solving, with a growing
            focus on data analytics, reporting, and process improvement.
        </p>

        <div class="hero-actions">
            <a class="btn btn-primary" href="#projects">Explore My Projects</a>
            <a class="btn btn-outline" href="#contact">Get in Touch</a>
        </div>
    </div>
</section>

<section class="about" id="about">
    <div class="about-content">
        <div class="section-heading">
            <h2>About Me</h2>
            <p>Analytical thinking built through diverse professional experience.</p>
        </div>

        <p>
            My professional experience spans law enforcement,
            sports medicine, and educational technology. Across
            these fields, I have consistently relied on gathering
            information, evaluating evidence, identifying patterns,
            and developing solutions to complex problems.
        </p>

        <p>
            My investigative background involved examining incidents,
            analyzing evidence, identifying contributing factors,
            and developing conclusions based on available information.
            In technology support, I have applied that same
            problem-solving approach to troubleshooting systems
            and improving operational processes.
        </p>

        <p>
            I am expanding these analytical capabilities into
            data analytics, with an emphasis on data collection,
            organization, reporting, visualization, and
            evidence-based decision-making.
        </p>
    </div>
</section>

<section id="projects">
    <div class="section-heading">
        <h2>Projects &amp; Practical Experience</h2>
        <p>Demonstrating analytical thinking through practical applications.</p>
    </div>

    <div class="project-grid">

        <article class="project-card">
            <h3>Project</h3>
            <p>
                Designed and developed a personal health data
                management application. Defined the application
                architecture, data organization, tracking features,
                and automated calculations. Used AI-assisted coding
                and independently evaluated, tested, and troubleshot
                implementation issues.
            </p>
            <span class="project-tag">Data Management</span>
            <span class="project-tag">Application Design</span>
            <span class="project-tag">Problem Solving</span>
        </article>

        <article class="project-card">
            <h3>Automated Repair Data Collection</h3>
            <p>
                Designed a data collection process using a form
                and an automated script to organize submitted
                repair information and populate the appropriate
                spreadsheet worksheets. Focused on improving
                data entry consistency and reducing manual
                organization.
            </p>
            <span class="project-tag">Data Collection</span>
            <span class="project-tag">Automation</span>
            <span class="project-tag">Excel</span>
        </article>

        <article class="project-card">
            <h3>Investigative Analysis</h3>
            <p>
                Applied systematic information gathering,
                evidence evaluation, pattern identification,
                and root-cause analysis throughout investigative
                work in law enforcement and sports medicine.
            </p>
            <span class="project-tag">Critical Thinking</span>
            <span class="project-tag">Research</span>
            <span class="project-tag">Root Cause Analysis</span>
        </article>

    </div>
</section>

<section class="skills" id="skills">
    <div class="section-heading">
        <h2>Skills &amp; Capabilities</h2>
        <p>Technical tools and analytical capabilities.</p>
    </div>

    <div class="skill-grid">

        <div class="skill-group">
            <h3>Data &amp; Reporting</h3>
            <p>
                Excel, spreadsheet organization,
                data collection, reporting,
                and data analysis development.
            </p>
        </div>

        <div class="skill-group">
            <h3>Technology</h3>
            <p>
                Google Workspace, Microsoft 365,
                application troubleshooting,
                process automation, and AI-assisted development.
            </p>
        </div>

        <div class="skill-group">
            <h3>Analytical Methods</h3>
            <p>
                Evidence evaluation, pattern recognition,
                root-cause analysis, critical thinking,
                and problem-solving.
            </p>
        </div>

        <div class="skill-group">
            <h3>Professional Experience</h3>
            <p>
                Investigations, operational support,
                information gathering, documentation,
                and cross-functional communication.
            </p>
        </div>

    </div>
</section>

<section class="contact" id="contact">
    <h2>Let's Connect</h2>
    <p>
        Interested in data analytics, reporting,
        and opportunities to turn information
        into meaningful solutions.
    </p>

    <!-- The address is shown as plain text so it can always be copied -->
    <div class="email-display" id="email-text">eron.awakuni@gmail.com</div>

    <div class="contact-links">
        <a class="btn btn-primary" href="mailto:eron.awakuni@gmail.com?subject=Portfolio%20Inquiry">Email Me</a>
        <button class="btn btn-outline" type="button" id="copy-email">Copy Email</button>
        <a class="btn btn-outline" href="https://github.com/EronAwakuni" target="_blank" rel="noopener noreferrer">GitHub</a>
    </div>

    <div class="copy-status" id="copy-status" role="status" aria-live="polite"></div>
</section>

</main>

<footer>
    <p>&copy; 2026 Eron Awakuni | Professional Portfolio</p>
</footer>

<script>
(function () {
    var email = "eron.awakuni@gmail.com";
    var button = document.getElementById("copy-email");
    var status = document.getElementById("copy-status");
    var emailBox = document.getElementById("email-text");

    function showStatus(message) {
        status.textContent = message;
        setTimeout(function () { status.textContent = ""; }, 3500);
    }

    function fallbackCopy() {
        // Select the visible address so the visitor can press Ctrl+C / Cmd+C
        var range = document.createRange();
        range.selectNodeContents(emailBox);
        var selection = window.getSelection();
        selection.removeAllRanges();
        selection.addRange(range);
        try {
            if (document.execCommand("copy")) {
                showStatus("Email address copied.");
                return;
            }
        } catch (e) {}
        showStatus("Address selected. Press Ctrl+C (or Cmd+C) to copy.");
    }

    button.addEventListener("click", function () {
        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(email).then(
                function () { showStatus("Email address copied."); },
                fallbackCopy
            );
        } else {
            fallbackCopy();
        }
    });
})();
</script>

</body>
</html>
